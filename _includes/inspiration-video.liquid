<div style="text-align: center; margin: 2rem auto; max-width: 900px;">
  <h2 style="font-size: 2rem; font-weight: 700; color: #222; margin-bottom: 1.5rem; border-bottom: 3px solid #0077ff; display: inline-block; padding-bottom: 0.5rem;">
     Inspiration
  </h2>
  <div style="position: relative; padding-bottom: 56.25%; height: 0; border-radius: 0.5rem; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.2);">
    <iframe 
      src="{{ include.youtube_url }}" 
      title="Inspiration Video"
      style="position: absolute; top:0; left:0; width:100%; height:100%; border:0; border-radius: 0.5rem;" 
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
      allowfullscreen>
    </iframe>
  </div>
</div>
