<figure class="viz-figure" style="text-align: center; margin: 1.5em 0;">
  <div class="visualization-html{% if include.full_width %} full-width{% endif %} viz-wrap">

    {% if include.image_path %}
      <img 
        class="vh-image {% if include.cover_image %}cover{% endif %}" 
        src="{{ site.cdn_url }}/assets/{{ include.image_path }}" 
        alt="{{ include.alt_text | default: include.title }}" 
        onerror="this.onerror=null; this.src='{{ site.fallback_cdn }}/assets/{{ include.image_path }}';"
      >
    {% endif %}

    {% if include.interactive_html %}
      <div class="interactive-plot-container vh-html viz-frame-box">
        <iframe
          class="viz-iframe"
          src="{{ '/assets/html_plots/' | append: include.interactive_html | relative_url }}"
          title="{{ include.alt_text | default: include.title | default: 'Interactive plot' }}"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    {% endif %}

  </div>

  {% capture interactive_button %}
    {% if include.interactive_html %}
      <a 
        class="view-interactive-html" 
        href="{{ '/assets/html_plots/' | append: include.interactive_html | relative_url }}" 
        target="_blank" 
        rel="noopener noreferrer" 
        style="text-decoration: none;"
      >
        📊 View Interactive Plot
      </a>
    {% endif %}
  {% endcapture %}

  {% capture caption %}
    {% if include.caption %}
      <figcaption class="figure-caption">
        {% if include.title %}
          <strong>{{ include.title }}</strong>
        {% endif %}
        {{ include.caption | markdownify }}
      </figcaption>
    {% endif %}

    {% if include.metrics %}
      <p style="margin-top: 8px; font-size: 0.85em; color: #666; font-style: italic;">
        {{ include.metrics }}
      </p>
    {% endif %}
  {% endcapture %}

  {% if include.interactive_button_first %}
    {{ interactive_button }}
    {{ caption }}
  {% else %}
    {{ caption }}
    {{ interactive_button }}
  {% endif %}

</figure>

<style>
  .viz-figure .viz-wrap {
    position: relative;
    overflow: visible !important;
    z-index: 10;
  }

  .viz-figure .viz-frame-box {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    height: {{ include.height | default: "600px" }};
    overflow: visible !important;
  }

  .viz-figure .viz-iframe {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, .08);
  }

  .viz-figure {
    overflow: visible !important;
  }
</style>


<script>
  (function () {
    // Find this figure and relax overflow on a few ancestors to prevent clipping.
    var fig = document.currentScript && document.currentScript.previousElementSibling;
    if (!fig) return;

    var hops = 0;
    var p = fig.parentElement;
    while (p && hops < 5) {
      var cs = getComputedStyle(p);
      if (/(hidden|auto|scroll)/.test(cs.overflow + cs.overflowX + cs.overflowY)) {
        p.style.overflow = 'visible';
      }
      if (cs.transform && cs.transform !== 'none') {
        p.style.transform = 'none';
      }
      p = p.parentElement;
      hops++;
    }

    // Auto-height for same-origin iframe; otherwise fallback to aspect ratio.
    var iframe = fig.querySelector('iframe.viz-iframe');
    if (!iframe) return;

    function setHeight() {
      try {
        var doc = iframe.contentDocument || iframe.contentWindow.document;
        if (!doc) return;

        var body = doc.body;
        var html = doc.documentElement;
        var h = Math.max(
          body.scrollHeight,
          body.offsetHeight,
          html.clientHeight,
          html.scrollHeight,
          html.offsetHeight
        );

        var maxPx = {{ include.max_height_px | default: 1400 }};
        iframe.style.height = Math.min(h, maxPx) + 'px';
        iframe.style.overflow = 'visible';
      } catch (e) {
        // Cross-origin; keep aspect-ratio sizing
      }
    }

    iframe.addEventListener('load', setHeight);

    try {
      var ro = new ResizeObserver(setHeight);
      ro.observe(iframe);
    } catch (e) {}
  })();
</script>
