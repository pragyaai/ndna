{% comment %}
Admonitio Title Template (Neural Genomics Version)
Usage:
{% include admonitio-title.liquid title="Neural Genomics Admonitio: ..." subtitle="Optional subtitle" %}
{% endcomment %}

{% assign heading_tag = include.size | default: "h1" %}
{% assign logo_size = "2.5em" %}

{% assign title_parts = include.title | split: "Neural Genomics" %}
{% assign before_ng = title_parts[0] | strip %}
{% assign after_ng = title_parts[1] | strip %}

<{{ heading_tag }} class="page-title" style="margin-bottom: {% if include.subtitle %}0.5em{% else %}1em{% endif %}; font-family: 'Montserrat', 'Roboto', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-weight: 700; letter-spacing: -0.02em;">
  <span class="page-title-ng">{{ before_ng }}<img src="{{ '/assets/img/Neural_genomics_img-1.png' | relative_url }}" alt="Neural Genomics" style="height: {{ logo_size }}; vertical-align: middle; margin: 0 0.2em;"></span><span>{{ after_ng }}</span>
</{{ heading_tag }}>

{% if include.subtitle %}
<p style="font-size: 1.1em; color: #666; margin-top: 0; margin-bottom: 1.5em; font-style: italic;">
  {{ include.subtitle }}
</p>
{% endif %}
