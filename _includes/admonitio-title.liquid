{% comment %}
Admonitio Title Template
Parameters:
- title: The title text (required)
- subtitle: Optional subtitle text
{% endcomment %}
{% assign heading_tag = include.size | default: "h1" %}
{% assign logo_size = "12em" %}

<!-- Video positioned on the right side to wrap around entire title section -->
<div style="float: right; margin: 0 0 1em 2em;">
  <iframe width="560" height="315" src="https://www.youtube.com/embed/RE0OTQbuCrc" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border-radius: 12px;"></iframe>
</div>

<div class="page-title-container" style="margin-bottom: {% if include.subtitle %}1em{% else %}1.5em{% endif %};">
  <!-- Logo and title content will flow around the video -->
  <div style="text-align: left;">
    <div style="margin-bottom: 0.5em;">
      <img src="{{ '/assets/img/Neural_genomics_img-1.png' | relative_url }}" alt="Neural Genomics" style="height: {{ logo_size }}; display: block; margin: 0 auto;">
    </div>
    <h1 class="page-title" style="margin: 0; font-family: 'Montserrat', 'Roboto', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-weight: 700; letter-spacing: -0.02em;">
      <span class="page-title-neural-genomics">{{ include.title }}</span>
    </h1>
  </div>
</div>
{% if include.subtitle %}
<p style="font-size: 1.1em; color: #666; margin-top: 0; margin-bottom: 1.5em; font-style: italic; text-align: left;">{{ include.subtitle }}</p>
{% endif %}
<div style="clear: both;"></div>
