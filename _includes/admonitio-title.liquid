{% comment %}
Admonitio Title Template
Usage: {% include admonitio-title.liquid title="Your Page Title" %}
{% endcomment %}

{% assign heading_tag = include.size | default: "h1" %}
{% assign logo_size = "12em" %}

<div class="page-title-container" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: {% if include.subtitle %}1em{% else %}1.5em{% endif %};">
  
  <h1 class="page-title" style="margin: 0; font-family: 'Montserrat', 'Roboto', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-weight: 700; letter-spacing: -0.02em;">
    <span class="page-title-admonitio">{{ include.title }}</span>
  </h1>

  <img src="{{ '/assets/img/Neural_genomics_img-1.png' | relative_url }}" 
       alt="Neural Genomics" 
       style="height: {{ logo_size }}; margin-left: 1em;">
</div>

{% if include.subtitle %}
<p style="font-size: 1.1em; color: #666; margin-top: 0; margin-bottom: 1.5em; font-style: italic; text-align: center;">
  {{ include.subtitle }}
</p>
{% endif %}
