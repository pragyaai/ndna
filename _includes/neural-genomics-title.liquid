{% comment %}
Neural Genomics Title Template
Usage: {% include neural-genomics-title.liquid title="Your Page Title" %}
Parameters:
- title: The title text (required)
- subtitle: Optional subtitle text
{% endcomment %}

{% assign heading_tag = include.size | default: "h1" %}
{% assign logo_size = "3.5em" %}

<div style="display: flex; align-items: center; margin-bottom: {% if include.subtitle %}0.5em{% else %}1em{% endif %};">
  <img src="{{ '/assets/img/Neural_genomics_img-1.png' | relative_url }}" alt="Neural Genomics" style="height: {{ logo_size }}; margin-right: 0.8em; flex-shrink: 0;">
  <{{ heading_tag }} class="page-title" style="margin: 0; font-family: 'Montserrat', 'Roboto', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-weight: 700; letter-spacing: -0.02em;">
    {{ include.title }}
  </{{ heading_tag }}>
</div>

{% if include.subtitle %}
<p style="font-size: 1.1em; color: #666; margin-top: 0; margin-bottom: 1.5em; font-style: italic;">{{ include.subtitle }}</p>
{% endif %}
