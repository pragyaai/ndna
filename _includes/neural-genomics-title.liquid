{% comment %}
Neural Genomics Title Template (fixed)
Usage:
  {% include neural-genomics-title.liquid
     title="Neural Genomics: A Paradigm Shift in Understanding Artificial Intelligence"
     subtitle="Optional subtitle text"
     heading_tag="h1"
     logo_size="3.5em" %}
Params:
- title (required): full title string
- subtitle (optional): secondary line under the title
- heading_tag (optional): h1–h6 (default h1)
- logo_size (optional): CSS size for the logo height (default 3.5em)
{% endcomment %}

{% assign heading_tag = include.heading_tag | default: "h1" %}
{% assign logo_size = include.logo_size | default: "3.5em" %}

{% capture logo_html %}
<span class="page-title-neural-genomics">
  <img src="{{ '/assets/img/Neural_genomics_img-1.png' | relative_url }}"
       alt="Neural Genomics"
       style="height: {{ logo_size }}; vertical-align: middle; margin: 0 0.35em 0 0;">
  Neural Genomics
</span>
{% endcapture %}

{% assign title_str = include.title | default: "" %}
{% assign contains_keyword = title_str contains "Neural Genomics" %}

{% if contains_keyword %}
  {% capture title_html %}
    {{ title_str | replace_first: "Neural Genomics", logo_html }}
  {% endcapture %}
{% else %}
  {% comment %}
  If the exact phrase isn't present, prepend the logo+text followed by the title.
  Change to render as-is if you don't want this behavior.
  {% endcomment %}
  {% capture title_html %}
    {{ logo_html }} {{ title_str }}
  {% endcapture %}
{% endif %}

<{{ heading_tag }} class="page-title"
  style="margin-bottom: {% if include.subtitle %}0.5em{% else %}1em{% endif %};
         font-family: 'Montserrat','Roboto','Open Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
         font-weight: 700; letter-spacing: -0.02em;">
  {{ title_html | raw }}
</{{ heading_tag }}>

{% if include.subtitle %}
<p style="font-size: 1.1em; color: #666; margin-top: 0; margin-bottom: 1.5em; font-style: italic;">
  {{ include.subtitle }}
</p>
{% endif %}
