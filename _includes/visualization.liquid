{% if include.caption %}
<figure style="text-align: center; margin: 1.5em 0;">
  <a href="{{ '/assets/gifs/' | append: include.gif_url | relative_url }}" data-lightbox="gallery" data-title="{{ include.title }}">
    <img src="{{ '/assets/gifs/' | append: include.gif_url | relative_url }}" alt="{{ include.title }}" style="max-width: 100%; height: 600px; object-fit: contain; border-radius: 8px; background-color: #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.08);">
  </a>
  <figcaption style="margin-top: 12px; font-size: 0.9em; line-height: 1.4; color: #555; max-width: 800px; margin-left: auto; margin-right: auto; text-align: left;">
    <strong>{{ include.title }}</strong>{% if include.caption %} {{ include.caption }}{% endif %}
  </figcaption>
  {% if include.metrics %}
    <p style="margin-top: 8px; font-size: 0.85em; color: #666; font-style: italic;">{{ include.metrics }}</p>
  {% endif %}
</figure>
{% else %}
<div style="text-align: center;">
  <a href="{{ '/assets/gifs/' | append: include.gif_url | relative_url }}" data-lightbox="gallery" data-title="{{ include.title }}">
    <img src="{{ '/assets/gifs/' | append: include.gif_url | relative_url }}" alt="{{ include.title }} Cultural nDNA Rotation" style="width: 100%; height: 300px; object-fit: contain; border-radius: 8px; background-color: #fff; box-shadow: 0 4px 8px rgba(0,0,0,0.08);">
  </a>
  <p style="margin-top: 8px; font-weight: 500;">{{ include.title }}</p>
  {% if include.metrics %}
    <p style="margin-top: 4px; font-size: 0.9em; color: #666;">{{ include.metrics }}</p>
  {% endif %}
</div>
{% endif %}
